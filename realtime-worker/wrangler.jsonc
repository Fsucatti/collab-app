{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "collab-realtime",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-03",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    // Exact origins, or *.suffix. Preview deployments are limited to this Vercel team.
    "ALLOWED_ORIGINS": "https://collab-app-fsucatti.vercel.app,*.francisco-sucattis-projects.vercel.app"
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "DocRoom" }]
  },
  "migrations": [
    // SQLite-backed classes are the ones available on the Workers free plan.
    { "tag": "v1", "new_sqlite_classes": ["DocRoom"] }
  ]
}
