# Postgres. This value matches docker-compose.yml.
DATABASE_URL="postgresql://app:app@localhost:5432/collab"

# NextAuth. Generate the secret with: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# GitHub OAuth App
GITHUB_ID=""
GITHUB_SECRET=""

# Realtime Worker. The secret must match realtime-worker/.dev.vars locally,
# or the Worker's secret in Cloudflare in production.
NEXT_PUBLIC_REALTIME_URL="http://localhost:3001"
REALTIME_HMAC_SECRET="dev-secret-change-me"

# Optional: largest document size, in characters
MAX_DOC_HTML_CHARS="400000"
